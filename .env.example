# ==============================================================================
# JARVIS Environment Configuration Example
# Copy this file to .env.local and update values with secure secrets.
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://jarvis:jarvis_secure_pass_change_me@localhost:5432/jarvis?schema=public"

# Database Configuration (for Docker Compose or Local Service)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secure_pass_change_me
POSTGRES_DB=jarvis
POSTGRES_PORT=5432

# Auth.js / NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Bootstrap Credentials
ADMIN_EMAIL="admin@jarvis.local"
ADMIN_NAME="Tony Stark"
ADMIN_INITIAL_PASSWORD="JarvisAdmin2026!"

# Local Storage
STORAGE_LOCAL_DIR="./data/uploads"
