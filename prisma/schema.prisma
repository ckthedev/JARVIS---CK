// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USER & SETTINGS
// -----------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("ADMIN")
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  settings       UserSettings?
  projects       Project[]
  tasks          Task[]
  taskCategories TaskCategory[]
  reminders      Reminder[]
  meetings       Meeting[]
  socialAccounts SocialAccount[]
  socialPosts    SocialPost[]
  notes          Note[]
  noteTags       NoteTag[]
  noteCategories NoteCategory[]
  folders        Folder[]
  storedFiles        StoredFile[]
  notifications      Notification[]
  reminderDeliveries ReminderDelivery[]

  @@map("users")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                String   @default("dark")
  timezone             String   @default("Asia/Kolkata")
  notificationEmail    Boolean  @default(true)
  notificationBrowser  Boolean  @default(true)
  digestFrequency      String   @default("DAILY")
  sidebarCollapsed     Boolean  @default(false)
  soundEnabled         Boolean  @default(true)
  soundTheme           String   @default("subtle") // subtle, chime, modern
  defaultSnoozeMinutes Int      @default(10)
  missedReminderPolicy String   @default("NOTIFY_IMMEDIATELY") // NOTIFY_IMMEDIATELY, SKIP_OLDER
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// -----------------------------------------------------------------------------
// TASKS & PROJECTS
// -----------------------------------------------------------------------------

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, status])
  @@map("projects")
}

model TaskCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("task_categories")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  projectId   String?
  categoryId  String?
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category  TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, deletedAt])
  @@map("tasks")
}

// -----------------------------------------------------------------------------
// REMINDERS & NOTIFICATIONS
// -----------------------------------------------------------------------------

model Reminder {
  id                   String    @id @default(uuid())
  userId               String
  taskId               String?
  meetingId            String?
  title                String
  description          String?
  dueAt                DateTime
  isCompleted          Boolean   @default(false)
  status               String    @default("PENDING") // PENDING, SENT, COMPLETED, SNOOZED, CANCELLED
  priority             String    @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  
  // Recurrence
  isRecurring          Boolean   @default(false)
  recurrenceRule       String?   // DAILY, WEEKLY, MONTHLY, YEARLY, CUSTOM
  recurrenceInterval   Int?      @default(1)
  recurrenceDaysOfWeek Int[]     @default([])
  recurrenceDayOfMonth Int?
  recurrenceMonth      Int?
  recurrenceEndAt      DateTime?
  nextRunAt            DateTime?

  // Offset for meeting-linked or task-linked reminders
  offsetMinutes        Int?

  // Snooze
  snoozedUntil         DateTime?
  snoozeCount          Int       @default(0)

  // Tracking & Lifecycle
  lastNotifiedAt       DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?
  missedPolicy         String    @default("NOTIFY_IMMEDIATELY") // NOTIFY_IMMEDIATELY, SKIP
  jobId                String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meeting       Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  deliveries    ReminderDelivery[]
  notifications Notification[]

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, isCompleted])
  @@index([userId, deletedAt])
  @@index([taskId])
  @@index([meetingId])
  @@map("reminders")
}

model ReminderDelivery {
  id          String   @id @default(uuid())
  reminderId  String
  userId      String
  scheduledAt DateTime
  deliveredAt DateTime @default(now())
  status      String   @default("DELIVERED") // DELIVERED, MISSED, FAILED, SNOOZED
  channel     String   @default("IN_APP") // IN_APP, BROWSER
  error       String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([userId, deliveredAt])
  @@map("reminder_deliveries")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  reminderId String?
  title      String
  message    String
  type       String    @default("INFO") // TASK, REMINDER, MEETING, SOCIAL, SYSTEM, INFO, WARNING, SUCCESS, ALERT
  isRead     Boolean   @default(false)
  link       String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([reminderId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// MEETINGS
// -----------------------------------------------------------------------------

model Meeting {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  meetingUrl  String?
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees MeetingAttendee[]
  reminders Reminder[]

  @@index([userId, startTime])
  @@index([userId, status])
  @@map("meetings")
}

model MeetingAttendee {
  id        String   @id @default(uuid())
  meetingId String
  name      String
  email     String?
  status    String   @default("INVITED") // INVITED, ACCEPTED, DECLINED, TENTATIVE
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_attendees")
}

// -----------------------------------------------------------------------------
// SOCIAL MEDIA
// -----------------------------------------------------------------------------

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  platform    String   // TWITTER, LINKEDIN, YOUTUBE, INSTAGRAM, GITHUB
  accountName String
  handle      String
  avatarUrl   String?
  status      String   @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@index([userId, platform])
  @@map("social_accounts")
}

model SocialPost {
  id              String    @id @default(uuid())
  userId          String
  socialAccountId String?
  content         String
  status          String    @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, FAILED
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  assets        SocialMediaAsset[]

  @@index([userId, status])
  @@index([userId, scheduledFor])
  @@map("social_posts")
}

model SocialMediaAsset {
  id           String   @id @default(uuid())
  socialPostId String
  fileId       String?
  url          String
  fileType     String
  createdAt    DateTime @default(now())

  socialPost SocialPost  @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([socialPostId])
  @@index([fileId])
  @@map("social_media_assets")
}

// -----------------------------------------------------------------------------
// NOTES
// -----------------------------------------------------------------------------

model Note {
  id         String    @id @default(uuid())
  userId     String
  categoryId String?
  title      String
  content    String
  plainText  String?   @default("")
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    NoteCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        NoteTagOnNote[]
  attachments NoteAttachment[]

  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
  @@index([userId, categoryId])
  @@index([userId, updatedAt])
  @@map("notes")
}

model NoteCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@unique([userId, name])
  @@index([userId])
  @@map("note_categories")
}

model NoteTag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTagOnNote[]

  @@unique([userId, name])
  @@index([userId])
  @@map("note_tags")
}

model NoteTagOnNote {
  noteId     String
  tagId      String
  assignedAt DateTime @default(now())

  note Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  NoteTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags_on_notes")
}

model NoteAttachment {
  id        String   @id @default(uuid())
  noteId    String
  fileId    String
  createdAt DateTime @default(now())

  note Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([noteId, fileId])
  @@index([noteId])
  @@index([fileId])
  @@map("note_attachments")
}

// -----------------------------------------------------------------------------
// FILE STORAGE
// -----------------------------------------------------------------------------

model Folder {
  id        String    @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  color     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]     @relation("FolderHierarchy")
  files    StoredFile[]

  @@index([userId, parentId])
  @@index([userId, deletedAt])
  @@map("folders")
}

model StoredFile {
  id             String    @id @default(uuid())
  userId         String
  folderId       String?
  originalName   String
  storageName    String    @unique
  storagePath    String
  mimeType       String
  sizeBytes      BigInt
  extension      String?
  category       String    @default("OTHER") // IMAGE, VIDEO, AUDIO, DOCUMENT, SPREADSHEET, PRESENTATION, ARCHIVE, CODE, OTHER
  checksum       String?
  metadata       Json?
  deletedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder            Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteAttachments   NoteAttachment[]
  socialMediaAssets SocialMediaAsset[]

  @@index([userId, folderId])
  @@index([userId, category])
  @@index([userId, deletedAt])
  @@index([userId, mimeType])
  @@index([userId, createdAt])
  @@map("stored_files")
}
