// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USER & SETTINGS
// -----------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("ADMIN")
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  settings       UserSettings?
  projects       Project[]
  tasks          Task[]
  taskCategories TaskCategory[]
  reminders      Reminder[]
  meetings       Meeting[]
  socialAccounts SocialAccount[]
  socialPosts    SocialPost[]
  notes          Note[]
  noteTags       NoteTag[]
  noteCategories NoteCategory[]
  folders        Folder[]
  storedFiles        StoredFile[]
  notifications      Notification[]
  reminderDeliveries ReminderDelivery[]
  socialCampaigns      SocialCampaign[]
  contentPillars       ContentPillar[]
  hashtags             Hashtag[]
  hashtagCollections   HashtagCollection[]
  socialPostActivities SocialPostActivity[]

  @@map("users")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                String   @default("dark")
  timezone             String   @default("Asia/Kolkata")
  notificationEmail    Boolean  @default(true)
  notificationBrowser  Boolean  @default(true)
  digestFrequency      String   @default("DAILY")
  sidebarCollapsed     Boolean  @default(false)
  soundEnabled         Boolean  @default(true)
  soundTheme           String   @default("subtle") // subtle, chime, modern
  defaultSnoozeMinutes Int      @default(10)
  missedReminderPolicy String   @default("NOTIFY_IMMEDIATELY") // NOTIFY_IMMEDIATELY, SKIP_OLDER
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// -----------------------------------------------------------------------------
// TASKS & PROJECTS
// -----------------------------------------------------------------------------

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, status])
  @@map("projects")
}

model TaskCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("task_categories")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  projectId   String?
  categoryId  String?
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category  TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  meetingId String?
  meeting   Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, deletedAt])
  @@index([meetingId])
  @@map("tasks")
}

// -----------------------------------------------------------------------------
// REMINDERS & NOTIFICATIONS
// -----------------------------------------------------------------------------

model Reminder {
  id                   String    @id @default(uuid())
  userId               String
  taskId               String?
  meetingId            String?
  socialPostId         String?
  title                String
  description          String?
  dueAt                DateTime
  isCompleted          Boolean   @default(false)
  status               String    @default("PENDING") // PENDING, SENT, COMPLETED, SNOOZED, CANCELLED
  priority             String    @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  
  // Recurrence
  isRecurring          Boolean   @default(false)
  recurrenceRule       String?   // DAILY, WEEKLY, MONTHLY, YEARLY, CUSTOM
  recurrenceInterval   Int?      @default(1)
  recurrenceDaysOfWeek Int[]     @default([])
  recurrenceDayOfMonth Int?
  recurrenceMonth      Int?
  recurrenceEndAt      DateTime?
  nextRunAt            DateTime?

  // Offset for meeting-linked or task-linked reminders
  offsetMinutes        Int?

  // Snooze
  snoozedUntil         DateTime?
  snoozeCount          Int       @default(0)

  // Tracking & Lifecycle
  lastNotifiedAt       DateTime?
  completedAt          DateTime?
  deletedAt            DateTime?
  missedPolicy         String    @default("NOTIFY_IMMEDIATELY") // NOTIFY_IMMEDIATELY, SKIP
  jobId                String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meeting       Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  socialPost    SocialPost?         @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  deliveries    ReminderDelivery[]
  notifications Notification[]

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([userId, isCompleted])
  @@index([userId, deletedAt])
  @@index([taskId])
  @@index([meetingId])
  @@index([socialPostId])
  @@map("reminders")
}

model ReminderDelivery {
  id          String   @id @default(uuid())
  reminderId  String
  userId      String
  scheduledAt DateTime
  deliveredAt DateTime @default(now())
  status      String   @default("DELIVERED") // DELIVERED, MISSED, FAILED, SNOOZED
  channel     String   @default("IN_APP") // IN_APP, BROWSER
  error       String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([userId, deliveredAt])
  @@map("reminder_deliveries")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  reminderId String?
  title      String
  message    String
  type       String    @default("INFO") // TASK, REMINDER, MEETING, SOCIAL, SYSTEM, INFO, WARNING, SUCCESS, ALERT
  isRead     Boolean   @default(false)
  link       String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([reminderId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// MEETINGS
// -----------------------------------------------------------------------------

model Meeting {
  id              String    @id @default(uuid())
  userId          String
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  timezone        String    @default("Asia/Kolkata")
  meetingType     String    @default("ONLINE") // ONLINE, PHYSICAL, PHONE
  priority        String    @default("NORMAL") // HIGH, NORMAL, LOW
  location        String?
  meetingUrl      String?
  status          String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, RESCHEDULED, NO_SHOW
  actualStartTime DateTime?
  actualEndTime   DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees   MeetingAttendee[]
  agendaItems MeetingAgendaItem[]
  notes       MeetingNoteLink[]
  tasks       Task[]
  attachments MeetingAttachment[]
  reminders   Reminder[]

  @@index([userId, startTime])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@map("meetings")
}

model MeetingAttendee {
  id           String   @id @default(uuid())
  meetingId    String
  name         String
  email        String?
  phone        String?
  organization String?
  role         String?
  status       String   @default("INVITED") // INVITED, ACCEPTED, DECLINED, TENTATIVE, ATTENDED, ABSENT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([email])
  @@map("meeting_attendees")
}

model MeetingAgendaItem {
  id              String   @id @default(uuid())
  meetingId       String
  title           String
  description     String?
  durationMinutes Int?     @default(15)
  sortOrder       Int      @default(0)
  isCompleted     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, sortOrder])
  @@map("meeting_agenda_items")
}

model MeetingNoteLink {
  id                String   @id @default(uuid())
  meetingId         String
  noteId            String
  discussionSummary String?
  keyDecisions      String?
  importantPoints   String?
  followUpInfo      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  note    Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([meetingId, noteId])
  @@index([meetingId])
  @@index([noteId])
  @@map("meeting_note_links")
}

model MeetingAttachment {
  id        String   @id @default(uuid())
  meetingId String
  fileId    String
  createdAt DateTime @default(now())

  meeting Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([meetingId, fileId])
  @@index([meetingId])
  @@index([fileId])
  @@map("meeting_attachments")
}

// -----------------------------------------------------------------------------
// SOCIAL MEDIA PLANNER & CONTENT WORKFLOW
// -----------------------------------------------------------------------------

model SocialCampaign {
  id            String       @id @default(uuid())
  userId        String
  name          String
  description   String?
  objective     String?
  startDate     DateTime?
  endDate       DateTime?
  status        String       @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, ARCHIVED
  platforms     String[]     @default([])
  internalNotes String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@index([userId, status])
  @@map("social_campaigns")
}

model ContentPillar {
  id          String       @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?      @default("#00D4FF")
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@unique([userId, name])
  @@index([userId])
  @@map("content_pillars")
}

model Hashtag {
  id          String                @id @default(uuid())
  userId      String
  tag         String                // normalized lowercase without leading #
  displayTag  String                // formatted tag e.g. #TechTrends
  category    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections HashtagInCollection[]
  posts       SocialPostHashtag[]

  @@unique([userId, tag])
  @@index([userId])
  @@map("hashtags")
}

model HashtagCollection {
  id          String                @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?               @default("#7A3FFF")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashtags HashtagInCollection[]

  @@unique([userId, name])
  @@index([userId])
  @@map("hashtag_collections")
}

model HashtagInCollection {
  hashtagId    String
  collectionId String
  createdAt    DateTime          @default(now())

  hashtag    Hashtag           @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  collection HashtagCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([hashtagId, collectionId])
  @@map("hashtags_in_collections")
}

model SocialAccount {
  id          String   @id @default(uuid())
  userId      String
  platform    String   // TWITTER, LINKEDIN, YOUTUBE, INSTAGRAM, GITHUB
  accountName String
  handle      String
  avatarUrl   String?
  status      String   @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@index([userId, platform])
  @@map("social_accounts")
}

model SocialPost {
  id              String               @id @default(uuid())
  userId          String
  socialAccountId String?
  campaignId      String?
  contentPillarId String?
  title           String               @default("Untitled Post")
  description     String?
  content         String               @default("")
  internalNotes   String?
  status          String               @default("DRAFT") // IDEA, DRAFT, IN_REVIEW, APPROVED, SCHEDULED, PUBLISHED, CANCELLED
  priority        String               @default("NORMAL") // HIGH, NORMAL, LOW
  plannedAt       DateTime?
  scheduledFor    DateTime?            // backward compatibility
  publishedAt     DateTime?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  timezone        String               @default("Asia/Kolkata")
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  campaign      SocialCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentPillar ContentPillar?       @relation(fields: [contentPillarId], references: [id], onDelete: SetNull)
  platforms     SocialPostPlatform[]
  media         SocialPostMedia[]
  hashtags      SocialPostHashtag[]
  activities    SocialPostActivity[]
  reminders     Reminder[]
  assets        SocialMediaAsset[]   // backward compatibility

  @@index([userId, status])
  @@index([userId, plannedAt])
  @@index([userId, scheduledFor])
  @@index([userId, campaignId])
  @@index([userId, contentPillarId])
  @@index([userId, deletedAt])
  @@map("social_posts")
}

model SocialPostPlatform {
  id          String     @id @default(uuid())
  postId      String
  platform    String     // INSTAGRAM, FACEBOOK, LINKEDIN, PINTEREST, THREADS, YOUTUBE
  caption     String?
  title       String?    // E.g. YouTube / Pinterest title
  description String?    // E.g. YouTube description
  customData  Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@index([platform])
  @@map("social_post_platforms")
}

model SocialPostMedia {
  id           String     @id @default(uuid())
  postId       String
  fileId       String
  displayOrder Int        @default(0)
  caption      String?
  createdAt    DateTime   @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([postId, fileId])
  @@index([postId, displayOrder])
  @@index([fileId])
  @@map("social_post_media")
}

model SocialPostHashtag {
  postId    String
  hashtagId String
  createdAt DateTime @default(now())

  post    SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag    @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([postId])
  @@index([hashtagId])
  @@map("social_post_hashtags")
}

model SocialPostActivity {
  id             String     @id @default(uuid())
  postId         String
  userId         String
  previousStatus String?
  newStatus      String?
  action         String     // CREATED, UPDATED, STATUS_CHANGED, RESCHEDULED, MEDIA_ATTACHED, REMINDER_SET, DUPLICATED, PUBLISHED_CONFIRMED
  details        String?
  createdAt      DateTime   @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("social_post_activities")
}

model SocialMediaAsset {
  id           String   @id @default(uuid())
  socialPostId String
  fileId       String?
  url          String
  fileType     String
  createdAt    DateTime @default(now())

  socialPost SocialPost  @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([socialPostId])
  @@index([fileId])
  @@map("social_media_assets")
}

// -----------------------------------------------------------------------------
// NOTES
// -----------------------------------------------------------------------------

model Note {
  id         String    @id @default(uuid())
  userId     String
  categoryId String?
  title      String
  content    String
  plainText  String?   @default("")
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    NoteCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        NoteTagOnNote[]
  attachments NoteAttachment[]
  meetingLinks MeetingNoteLink[]

  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
  @@index([userId, categoryId])
  @@index([userId, updatedAt])
  @@map("notes")
}

model NoteCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@unique([userId, name])
  @@index([userId])
  @@map("note_categories")
}

model NoteTag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTagOnNote[]

  @@unique([userId, name])
  @@index([userId])
  @@map("note_tags")
}

model NoteTagOnNote {
  noteId     String
  tagId      String
  assignedAt DateTime @default(now())

  note Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  NoteTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags_on_notes")
}

model NoteAttachment {
  id        String   @id @default(uuid())
  noteId    String
  fileId    String
  createdAt DateTime @default(now())

  note Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([noteId, fileId])
  @@index([noteId])
  @@index([fileId])
  @@map("note_attachments")
}

// -----------------------------------------------------------------------------
// FILE STORAGE
// -----------------------------------------------------------------------------

model Folder {
  id        String    @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  color     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]     @relation("FolderHierarchy")
  files    StoredFile[]

  @@index([userId, parentId])
  @@index([userId, deletedAt])
  @@map("folders")
}

model StoredFile {
  id             String    @id @default(uuid())
  userId         String
  folderId       String?
  originalName   String
  storageName    String    @unique
  storagePath    String
  mimeType       String
  sizeBytes      BigInt
  extension      String?
  category       String    @default("OTHER") // IMAGE, VIDEO, AUDIO, DOCUMENT, SPREADSHEET, PRESENTATION, ARCHIVE, CODE, OTHER
  checksum       String?
  metadata       Json?
  deletedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder            Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteAttachments   NoteAttachment[]
  socialMediaAssets SocialMediaAsset[]
  meetingAttachments MeetingAttachment[]
  socialPostMedia   SocialPostMedia[]

  @@index([userId, folderId])
  @@index([userId, category])
  @@index([userId, deletedAt])
  @@index([userId, mimeType])
  @@index([userId, createdAt])
  @@map("stored_files")
}
